<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title> Todo List Application </title>
    <!-- Include Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .todo-header{
            background-color: darkcyan;
            color: white;
        }
        .complete-header{
            background-color: green;
            color: white;
        }
    </style>
</head>
<body>
    <div class = "container text-center mt-5">
        <h1 class= "container mb-5"> Todo List </h1>

        <div class= "row">
            <!-- Todo task not completed -->
            <div class= " col-md-6">
                <div class = "card mb-4 todo-box">
                    <div class="card-header todo-header">
                        <h2> Todo Tasks </h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        <% todoTasks.forEach(task =>{ %>
                            <li class="list-group-item">
                                <strong> User <%= task.userId %>:</strong> <%= task.title%> 
                            </li>
                            <% }); %>
                    </ul>
            </div>
        </div>

         <!-- Completed Task -->
        <div class= " col-md-6">
            <div class = "card mb-4">
                <div class="card-header complete-header">
                    <h2> Completed Task </h2>
                </div>
                <ul class="list-group list-group-flush">
                    <% completedTasks.forEach(task => { %>
                        <li class="list-group-item">
                            <strong> User <%= task.userId %>:</strong> <% task.title %> 
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>

    <!-- making a back button -->
    <div class= "text-center">
        <button class="btn btn-secondary" onclick="window.location.href='/'"> 
            Go Back 
        </button>
    </div>
</div>
    <!-- including bootstrap js bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>